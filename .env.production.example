# ==============================================================================
# MediCare Hospital Management System — Production Environment Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. NEVER commit live production secrets, real passwords, or production keys.
# 2. Copy this file to '.env' on the production server (outside public web root).
# 3. Generate APP_KEY on the server via: php artisan key:generate --force
# 4. Enforce HTTPS across all endpoints (APP_URL=https://...).
# ==============================================================================

# --- Application Core Settings ---
APP_NAME="MediCare Hospital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://medicare.kennedycheroben.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Production Logging (Daily Log Rotation to Prevent Disk Exhaustion) ---
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Database Connection (MySQL / MariaDB on cPanel / Truehost) ---
# NOTE: In cPanel, database names and usernames include the cPanel account prefix (e.g. xqtrqexj_).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xqtrqexj_medicare_prod
DB_USERNAME=xqtrqexj_medicare_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Session & Security Cookie Hardening (Strict HTTPS Requirements) ---
# 'database' driver ensures sessions are concurrency-safe and survive server restarts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# --- Caching, Queues & Broadcasting ---
# In shared hosting environments without Redis daemon, 'database' or 'file' is recommended.
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# --- Filesystem Storage (Media, News Covers, Clinical Documents) ---
# Ensure 'php artisan storage:link' is executed on the production server.
FILESYSTEM_DISK=public

# --- Production Transactional Mail (SMTP) ---
# Required for live patient portal activation, password recovery, and inquiries.
# Supported providers: Amazon SES, Mailgun, Postmark, Sendgrid, or Truehost Authenticated SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-production-smtp-username
MAIL_PASSWORD=your-production-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@medicare.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# --- Hospital Identity & Kenyan Localization (Production Values) ---
HOSPITAL_NAME="MediCare Hospital"
HOSPITAL_TAGLINE="Comprehensive Healthcare Management System"
HOSPITAL_CITY="Nairobi"
HOSPITAL_COUNTRY="Kenya"
HOSPITAL_ADDRESS="Upper Hill Medical District, Nairobi, Kenya"
HOSPITAL_PHONE="+254 20 790 0000"
HOSPITAL_EMERGENCY_PHONE="+254 700 911 911"
HOSPITAL_MOBILE_PHONE="+254 711 000 000"
HOSPITAL_EMAIL="info@medicare.co.ke"
HOSPITAL_EMERGENCY_EMAIL="emergency@medicare.co.ke"
HOSPITAL_HOURS="24/7 Emergency & Inpatient Care"
HOSPITAL_OPD_HOURS="Mon - Sat: 8:00 AM - 6:00 PM"
HOSPITAL_DEFAULT_COUNTRY_CODE="+254"
HOSPITAL_CURRENCY="KES"
HOSPITAL_CURRENCY_SYMBOL="KSh"

# When false, demo warnings are hidden and official regulatory notices are presented.
HOSPITAL_DEMO_MODE=false
HOSPITAL_ACCREDITATION_NOTICE="Licensed by Kenya Medical Practitioners and Dentists Council (KMPDC)"
